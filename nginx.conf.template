# nginx del frontend: sirve la SPA de Angular y reenvía /api/* al API Gateway.
# El prefijo /api existe solo en el navegador; se elimina antes de llegar al Gateway,
# que enruta /auth-service/**, /catalog-service/**, etc.
server {
    listen 80;
    server_name _;
    root /usr/share/nginx/html;
    index index.html;

    gzip on;
    gzip_types text/css application/javascript application/json image/svg+xml;

    location /api/ {
        rewrite ^/api/(.*)$ /$1 break;
        proxy_pass ${API_GATEWAY_URL};
        proxy_http_version 1.1;
        proxy_set_header Host $proxy_host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_read_timeout 60s;
    }

    location ~* \.(js|css|woff2?|ico|png|svg)$ {
        expires 30d;
        add_header Cache-Control "public, immutable";
        try_files $uri =404;
    }

    # Rutas de Angular (/pedidos/5, /dashboard...) devuelven index.html.
    location / {
        try_files $uri $uri/ /index.html;
    }
}
